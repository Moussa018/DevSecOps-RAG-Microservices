#!/bin/bash
# Bootstrap of a k3s AGENT node (ingest or query subnet). It joins the server in the core subnet.
set -euxo pipefail

dnf install -y tar gzip jq

K3S_TOKEN="$(aws secretsmanager get-secret-value --secret-id ${k3s_secret} --region ${region} --query SecretString --output text)"

# Wait for the server API (the supervisor answers on /ping)
until curl -ksf "https://${server_ip}:6443/ping" >/dev/null; do sleep 5; done

curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION=v1.31.4+k3s1 \
  K3S_URL="https://${server_ip}:6443" K3S_TOKEN="$K3S_TOKEN" \
  sh -s - agent --node-label role=${node_role}

touch /opt/rag/.joined 2>/dev/null || true
